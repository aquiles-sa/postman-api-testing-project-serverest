          "name": "tc-usu-007 | Retornar todos os usuários cadastrados",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const responseBody = pm.response.json();\r\n\r\nconst usersQuantity = responseBody.usuarios.length;\r\nconst randomUserIndex = Math.floor(Math.random() * usersQuantity);\r\n\r\nlet getRandomEmail = responseBody.usuarios[randomUserIndex].email;\r\nlet getRandomId = responseBody.usuarios[randomUserIndex]._id;\r\n\r\npm.collectionVariables.set(\"random_existing_email\", getRandomEmail);\r\npm.collectionVariables.set(\"random_existing_id\", getRandomId);\r\n\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Quantidade de usuários é maior que zero\", function () {\r\n    pm.expect(responseBody.quantidade).to.be.greaterThan(0);\r\n});\r\n\r\npm.test(\"Lista de usuários não está vazia\", function () {\r\n    pm.expect(responseBody.usuarios).length.to.be.greaterThan(0)\r\n});"
                ]
              }
            }
          ],
