            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const getResponse = await pm.sendRequest({\r\n    url: pm.environment.get(\"base_url\") + \"/usuarios\",\r\n    method: \"GET\",\r\n});\r\n\r\nconst responseBody = getResponse.json();\r\n\r\nconst usersQuantity = responseBody.usuarios.length;\r\nconst randomUserIndex = Math.floor(Math.random() * usersQuantity);\r\n\r\nlet getRandomEmail = responseBody.usuarios[randomUserIndex].email;\r\npm.environment.set(\"random_existing_email\", getRandomEmail);\r\n\r\n\r\n"
                ]
