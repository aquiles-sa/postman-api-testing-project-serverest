            "exec": [
              "const responseBody = pm.response.json();\r\n\r\npm.test(\"Status code is 400\", function () {\r\n    pm.response.to.have.status(400);\r\n});\r\n\r\npm.test(\"Mensagens de falta de preenchimento dos campos estão corretas\", function () {\r\n    pm.expect(responseBody.email).to.eql(\"email não pode ficar em branco\");\r\n    pm.expect(responseBody.password).to.eql(\"password não pode ficar em branco\");\r\n});"
            ]
