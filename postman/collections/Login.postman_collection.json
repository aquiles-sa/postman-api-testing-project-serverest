  "item": [
    {
      "name": "tc-log-001 | Login de usuário válido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const responseBody = pm.response.json();\r\n\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"A mensagem da resposta: 'Login realizado com sucesso\", function () {\r\n    pm.expect(responseBody.message).to.eql(\"Login realizado com sucesso\");\r\n});\r\n\r\npm.test(\"Bearer token foi gerado\", function() {\r\n    pm.expect(responseBody.authorization).to.exist;\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"{{user_email}}\",\r\n  \"password\": \"{{user_password}}\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "login"
          ]
        }
      },
      "response": []
    },
